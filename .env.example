# Make.com Webhooks
# Get this URL from your Make.com scenario webhook trigger
MAKE_CONTACT_FORM_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id-here

# Stripe (for future e-commerce integration)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Google Sheets API
# Required for running the setup-sheets script to auto-generate your operational spreadsheet
# See /docs/GOOGLE_CLOUD_SETUP.md for detailed setup instructions
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID (created after running npm run setup-sheets)
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-script-output
